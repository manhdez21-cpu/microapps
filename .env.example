# Copia este archivo como .env (está en .gitignore) o define las variables en el entorno. Nunca escribas valores reales aquí.

# --- Pro (licencias) ---
# Clave PRIVADA que firma las licencias (sale de `node tools/pro-license.mjs keygen`). SECRETO: solo en el entorno de quien emite licencias.
PRO_PRIVATE_KEY=
# Pública, no secreta. 1 = compilación para Google Play (TWA): el modal no muestra precio ni enlace de pago.
PRO_HIDE_PURCHASE=
